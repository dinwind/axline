# ---------------------------------------------------------------------------
# Built-in extension install artifacts (AxLine fork)
#
# build/npm/postinstall.ts installs each bundled extension's dependencies at the
# repository root on Windows (instead of preserving the extensions/<name>
# symlink), producing <name>/package*.json + <name>/node_modules. These are
# generated build outputs and must not be committed.
# ---------------------------------------------------------------------------
